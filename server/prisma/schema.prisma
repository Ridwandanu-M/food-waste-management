// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum PlanStatus {
  DRAFT
  APPROVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords    DailyRecord[]
  productionPlans ProductionPlan[]

  @@map("users")
}

model Menu {
  id        String   @id @default(cuid())
  name      String
  category  String
  unit      String
  baseCost  Float
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords    DailyRecord[]
  forecastResults ForecastResult[]
  productionPlans ProductionPlan[]

  @@map("menus")
}

model DailyRecord {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  actualProduction Float
  actualSales      Float
  wasteAmount      Float
  menuId           String
  staffId          String
  createdAt        DateTime @default(now())

  menu  Menu @relation(fields: [menuId], references: [id])
  staff User @relation(fields: [staffId], references: [id])

  @@unique([menuId, date, staffId])
  @@index([menuId, date])
  @@map("daily_records")
}

model ForecastResult {
  id              String   @id @default(cuid())
  targetDate      DateTime @db.Date
  predictedDemand Float
  confidenceLevel Float    @default(0)
  insight         String?
  menuId          String
  createdAt       DateTime @default(now())

  menu Menu @relation(fields: [menuId], references: [id])

  @@index([menuId, targetDate])
  @@map("forecast_results")
}

model ProductionPlan {
  id              String     @id @default(cuid())
  targetDate      DateTime   @db.Date
  predictedAmount Float
  plannedAmount   Float
  warningStatus   String     @default("AMAN")
  status          PlanStatus @default(DRAFT)
  menuId          String
  managerId       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  menu    Menu @relation(fields: [menuId], references: [id])
  manager User @relation(fields: [managerId], references: [id])

  @@unique([menuId, targetDate])
  @@index([targetDate])
  @@map("production_plans")
}

model SystemSettings {
  id                      String   @id @default(cuid())
  restaurantName          String   @default("")
  timezone                String   @default("Asia/Jakarta")
  currency                String   @default("IDR")
  wasteTolerancePercent   Int      @default(15)
  notifyDailySummary      Boolean  @default(true)
  notifyWarningEscalation Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("system_settings")
}
